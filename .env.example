MODEL_PROVIDER=openai_compatible
MODEL_NAME=replace-with-your-model
MODEL_BASE_URL=https://your-provider.example/v1
MODEL_API_KEY=replace-with-your-key
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# Required for V2 knowledge-base ingestion. These may point to a different
# OpenAI-compatible provider than the chat model.
EMBEDDING_MODEL=replace-with-your-embedding-model
EMBEDDING_BASE_URL=https://your-provider.example/v1
EMBEDDING_API_KEY=replace-with-your-key
DATA_DIR=.data

# Optional runtime limits
TASK_TIMEOUT_SECONDS=180
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=1
TOOL_TIMEOUT_SECONDS=30
MAX_SEARCH_ROUNDS=3
MAX_TOOL_CALLS=12
MAX_UPLOAD_MB=20
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
KNOWLEDGE_TIMEOUT_SECONDS=120
